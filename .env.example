# Copy this file to .env for local development and replace both values.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
SITE_URL=http://127.0.0.1:5000

# Persistent Firebase configuration. On Render, prefer the JSON secret.
FIREBASE_CREDENTIAL_PATH=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# Optional browser push notification configuration for production.
# Generate a new pair with: python generate_vapid.py
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:okonudestiny4@gmail.com
